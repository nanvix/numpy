# Makefile.nanvix - NumPy cross-compilation for Nanvix
#
# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# Usage:
#   make -f Makefile.nanvix CONFIG_NANVIX=y NANVIX_HOME=/path/to/nanvix all
#
# NumPy uses Meson/Ninja for cross-compilation. This Makefile wraps
# the Meson setup + Ninja build + archive creation process.
#
# Prerequisites:
#   - Host python3, ninja-build, pkg-config
#   - CPython headers + pkg-config files in sysroot
#   - nanvix-cross.ini cross file (generated by this Makefile)

NANVIX_DOCKER_IMAGE ?= nanvix/toolchain:latest-minimal

ifdef CONFIG_NANVIX
  NANVIX_TOOLCHAIN ?= /opt/nanvix
  NANVIX_HOME ?= $(HOME)/nanvix

  ifndef CONFIG_NANVIX_DOCKER
    ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc),)
      DOCKER_AVAILABLE := $(shell command -v docker 2>/dev/null)
      ifdef DOCKER_AVAILABLE
        DOCKER_IMAGE_EXISTS := $(shell docker image inspect $(NANVIX_DOCKER_IMAGE) >/dev/null 2>&1 && echo yes)
        ifdef DOCKER_IMAGE_EXISTS
          CONFIG_NANVIX_DOCKER := y
          $(info [INFO] Native toolchain not found at $(NANVIX_TOOLCHAIN), using Docker image $(NANVIX_DOCKER_IMAGE))
        else
          $(error Docker image $(NANVIX_DOCKER_IMAGE) not found. Run: docker pull $(NANVIX_DOCKER_IMAGE))
        endif
      else
        $(error Nanvix toolchain not found at $(NANVIX_TOOLCHAIN) and Docker is not available)
      endif
    endif
  else
    DOCKER_AVAILABLE := $(shell command -v docker 2>/dev/null)
    ifndef DOCKER_AVAILABLE
      $(error CONFIG_NANVIX_DOCKER=y but Docker is not installed)
    endif
    DOCKER_IMAGE_EXISTS := $(shell docker image inspect $(NANVIX_DOCKER_IMAGE) >/dev/null 2>&1 && echo yes)
    ifndef DOCKER_IMAGE_EXISTS
      $(error Docker image $(NANVIX_DOCKER_IMAGE) not found. Run: docker pull $(NANVIX_DOCKER_IMAGE))
    endif
    $(info [INFO] Using Docker image $(NANVIX_DOCKER_IMAGE) (explicitly requested))
  endif

  SYSROOT_PATH := $(abspath $(NANVIX_HOME))
  TOOLCHAIN_PREFIX := $(NANVIX_TOOLCHAIN)
  AR := $(TOOLCHAIN_PREFIX)/bin/i686-nanvix-ar

  CROSS_FILE := nanvix-cross.ini
  BUILDDIR := builddir
  NUMPY_LIB_DIR := $(SYSROOT_PATH)/lib/numpy
else
  ifneq ($(MAKECMDGOALS),clean)
    $(error CONFIG_NANVIX must be set to 'y'. Usage: make -f Makefile.nanvix CONFIG_NANVIX=y NANVIX_HOME=/path/to/nanvix)
  endif
endif

CONFIGURED_MARKER = .nanvix-configured

all: archives

# Generate Meson cross file
$(CROSS_FILE):
	@echo "Generating Meson cross file..."
	@echo '[binaries]' > $@
	@echo "c = '$(TOOLCHAIN_PREFIX)/bin/i686-nanvix-gcc'" >> $@
	@echo "cpp = '$(TOOLCHAIN_PREFIX)/bin/i686-nanvix-g++'" >> $@
	@echo "ar = '$(TOOLCHAIN_PREFIX)/bin/i686-nanvix-ar'" >> $@
	@echo "strip = '$(TOOLCHAIN_PREFIX)/bin/i686-nanvix-strip'" >> $@
	@echo "pkgconfig = 'pkg-config'" >> $@
	@echo '' >> $@
	@echo '[built-in options]' >> $@
	@echo "c_args = ['-I$(SYSROOT_PATH)/include', '-I$(SYSROOT_PATH)/include/python3.12']" >> $@
	@echo "c_link_args = ['-static', '-L$(SYSROOT_PATH)/lib', '-T$(SYSROOT_PATH)/lib/user.ld', '-Wl,--start-group', '$(SYSROOT_PATH)/lib/libposix.a', '$(TOOLCHAIN_PREFIX)/i686-nanvix/lib/libc.a', '$(TOOLCHAIN_PREFIX)/i686-nanvix/lib/libm.a', '-Wl,--end-group']" >> $@
	@echo "cpp_args = ['-I$(SYSROOT_PATH)/include', '-I$(SYSROOT_PATH)/include/python3.12']" >> $@
	@echo "cpp_link_args = ['-static', '-L$(SYSROOT_PATH)/lib', '-T$(SYSROOT_PATH)/lib/user.ld', '-Wl,--start-group', '$(SYSROOT_PATH)/lib/libposix.a', '$(TOOLCHAIN_PREFIX)/i686-nanvix/lib/libc.a', '$(TOOLCHAIN_PREFIX)/i686-nanvix/lib/libm.a', '-lstdc++', '-Wl,--end-group']" >> $@
	@echo '' >> $@
	@echo '[host_machine]' >> $@
	@echo "system = 'nanvix'" >> $@
	@echo "cpu_family = 'x86'" >> $@
	@echo "cpu = 'i686'" >> $@
	@echo "endian = 'little'" >> $@
	@echo '' >> $@
	@echo '[properties]' >> $@
	@echo "longdouble_format = 'IEEE_DOUBLE_LE'" >> $@
	@echo "needs_exe_wrapper = true" >> $@

# Configure with Meson
configure: $(CONFIGURED_MARKER)

$(CONFIGURED_MARKER): $(CROSS_FILE)
	PKG_CONFIG_LIBDIR="$(SYSROOT_PATH)/lib/pkgconfig" \
	/usr/bin/python3 vendored-meson/meson/meson.py setup $(BUILDDIR) \
	    --cross-file $(CROSS_FILE) \
	    --pkg-config-path="$(SYSROOT_PATH)/lib/pkgconfig" \
	    -Dallow-noblas=true \
	    -Ddisable-optimization=true
	touch $(CONFIGURED_MARKER)

# Build with Ninja (tolerate partial failures)
build: $(CONFIGURED_MARKER)
	ninja -C $(BUILDDIR) -j$$(nproc) -k 0 || true

# Create static archives from build outputs
archives: build
	mkdir -p $(NUMPY_LIB_DIR)
	@# Main multiarray_umath
	@mkdir -p /tmp/numpy_objs && cd /tmp/numpy_objs && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/core/_multiarray_umath.*.so.p/*.o . 2>/dev/null || true; \
	  for d in $(CURDIR)/$(BUILDDIR)/numpy/core/lib*.a.p; do \
	    [ -d "$$d" ] && cp "$$d"/*.o . 2>/dev/null || true; \
	  done; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/lib_multiarray_umath_all.a *.o
	@# npymath
	@mkdir -p /tmp/npyobj && cd /tmp/npyobj && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/core/libnpymath.a.p/*.o . 2>/dev/null || true; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/libnpymath.a *.o
	@# npyrandom
	@cd /tmp/npyobj && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/random/libnpyrandom.a.p/*.o . 2>/dev/null || true; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/libnpyrandom.a *.o
	@# FFT
	@cd /tmp/npyobj && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/fft/_pocketfft_internal.*.so.p/*.o . 2>/dev/null || true; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/lib_pocketfft_internal.a *.o
	@# Linalg
	@for mod in lapack_lite _umath_linalg; do \
	  cd /tmp/npyobj && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/linalg/$${mod}.*.so.p/*.o . 2>/dev/null || true; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/lib$${mod}.a *.o; \
	done
	@# Random modules
	@for mod in _bounded_integers _common _generator _mt19937 _pcg64 _philox _sfc64 bit_generator mtrand; do \
	  cd /tmp/npyobj && rm -f *.o && \
	  cp $(CURDIR)/$(BUILDDIR)/numpy/random/$${mod}.*.so.p/*.o . 2>/dev/null || true; \
	  $(AR) rcs $(NUMPY_LIB_DIR)/lib_random_$${mod}.a *.o; \
	done
	@rm -rf /tmp/numpy_objs /tmp/npyobj
	@echo "NumPy archives created:"
	@ls -la $(NUMPY_LIB_DIR)/

install: archives
	@echo "NumPy archives already installed to $(NUMPY_LIB_DIR)"

clean:
	rm -rf $(BUILDDIR) $(CROSS_FILE) $(CONFIGURED_MARKER)

.PHONY: all configure build archives install clean
